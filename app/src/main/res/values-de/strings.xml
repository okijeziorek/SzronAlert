    <!-- Garden Seasonal Tips -->
    <string name="garden_seasonal_tip_format">%1$s %2$s</string>
    <string name="tip_january_1">Winterpflanzenabdeckungen nach jedem Tauwetter prüfen.</string>
    <string name="tip_january_2">Garten für kommende Saison planen, Samen aus Katalogen bestellen.</string>
    <string name="tip_january_3">Obstbäume bei Frost schneiden, wenn Saft nicht fließt.</string>
    <string name="tip_february_1">Gemüsesetzlinge zu Hause beginnen (Tomaten, Paprika).</string>
    <string name="tip_february_2">Ziersträucher vor dem Aufwachen schneiden.</string>
    <string name="tip_february_3">Pflanzen auf überwinternde Schädlinge unter Rinde prüfen.</string>
    <string name="tip_march_1">Winterabdeckungen entfernen, wenn Temperaturen nicht unter -5°C fallen.</string>
    <string name="tip_march_2">Frühes Gemüse säen: Salat, Spinat, Radieschen.</string>
    <string name="tip_march_3">Bewässerung wieder aufnehmen, wenn Boden in Schichten auftaut.</string>
    <string name="tip_april_1">Auf Fröste achten! Mai ist der Monat der \'Eisheiligen\'.</string>
    <string name="tip_april_2">Setzlinge in Töpfe umpflanzen, nicht vor 15. Mai nach draußen.</string>
    <string name="tip_april_3">Kräuter im Boden säen: Petersilie, Dill, Koriander.</string>
    <string name="tip_may_1">Nach dem 15. Mai wärmeliebende Gemüsesetzlinge nach draußen pflanzen.</string>
    <string name="tip_may_2">Regelmäßiges Gießen beginnen – Frühlingsregen oft unzureichend.</string>
    <string name="tip_may_3">Rosen- und Staudenabdeckungen lösen und aufrollen.</string>
    <string name="tip_june_1">Boden mulchen, um Feuchtigkeit zu halten und Unkraut zu hemmen.</string>
    <string name="tip_june_2">Morgens oder abends gießen, Mittag vermeiden.</string>
    <string name="tip_june_3">Erdbeerernte – Früchte nicht zu lange auf Sträuchern lassen.</string>
    <string name="tip_july_1">UV-Index prüfen – Gartenarbeit zwischen 11 und 15 Uhr einschränken.</string>
    <string name="tip_july_2">Gemüse bei Hitze benötigt tägliches Gießen, besonders Tomaten.</string>
    <string name="tip_july_3">Kräuter morgens ernten, wenn ätherische Öle am intensivsten sind.</string>
    <string name="tip_august_1">Herbstgemüse säen: Brokkoli, Kohlrabi, Salat.</string>
    <string name="tip_august_2">Frühe Sorten von Äpfeln und Pflaumen ernten.</string>
    <string name="tip_august_3">Gießen zum Monatsende reduzieren, um Pflanzen abzuhärten.</string>
    <string name="tip_september_1">Kürbisse und Zucchini vor den ersten Frösten ernten.</string>
    <string name="tip_september_2">Tulpen-, Narzissen- und Hyazinthenzwiebeln pflanzen.</string>
    <string name="tip_september_3">Vlies vorbereiten – Fröste können diesen Monat auftreten.</string>
    <string name="tip_october_1">Rosen und frostempfindliche Stauden abdecken.</string>
    <string name="tip_october_2">Wurzelgemüse ernten: Karotten, Petersilie, Pastinaken – Frost süßt sie.</string>
    <string name="tip_october_3">Blätter kompostieren – ausgezeichneter Dünger für nächstes Jahr.</string>
    <string name="tip_november_1">Pflanzen vor Frost schützen: Vlies, Stroh, Kiefernnadeln.</string>
    <string name="tip_november_2">Empfindliche Topfpflanzen in kühlen Raum bringen.</string>
    <string name="tip_november_3">Beobachtungen der endenden Saison notieren für bessere Planung.</string>
    <string name="tip_december_1">Abdeckungen nach starkem Schneefall prüfen.</string>
    <string name="tip_december_2">Zeit für Gartenlektüre und Planung für neues Jahr.</string>
    <string name="tip_december_3">An Vögel im Garten denken – Futterstelle aufhängen.</string>

