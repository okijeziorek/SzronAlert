    <!-- Garden Seasonal Tips -->
    <string name="garden_seasonal_tip_format">%1$s %2$s</string>

    <!-- January Tips -->
    <string name="tip_january_1">❄️ Zkontrolujte zimní přikrývky rostlin po každém tání.</string>
    <string name="tip_january_2">📋 Naplánujte zahradu na příští sezónu, objednejte semena z katalogů.</string>
    <string name="tip_january_3">✂️ Prořezávejte ovocné stromy během mrazu, kdy míza neteče.</string>

    <!-- February Tips -->
    <string name="tip_february_1">🌱 Začněte se setbou zeleniny na sazenice doma (rajčata, papriky).</string>
    <string name="tip_february_2">✂️ Prořezejte okrasné keře před jejich probuzením.</string>
    <string name="tip_february_3">🐛 Zkontrolujte rostliny na škůdce přezimující pod kůrou.</string>

    <!-- March Tips -->
    <string name="tip_march_1">🌷 Odstraňte zimní přikrývky, když teploty neklesají pod -5°C.</string>
    <string name="tip_march_2">🌱 Zasejte ranou zeleninu: salát, špenát, ředkvičky.</string>
    <string name="tip_march_3">💧 Obnovte zalévání, když půda rozmrzne po vrstvách.</string>

    <!-- April Tips -->
    <string name="tip_april_1">⚠️ Pozor na mrazíky! Květen je měsíc \'Zmrzlých svatých\'.</string>
    <string name="tip_april_2">🍅 Přesaďte sazenice do květináčů, nevynášejte je před 15. květnem.</string>
    <string name="tip_april_3">🌿 Zasejte byliny přímo do půdy: petržel, kopr, koriandr.</string>

    <!-- May Tips -->
    <string name="tip_may_1">🌡️ Po 15. květnu vysaďte sazenice teplomilné zeleniny venku.</string>
    <string name="tip_may_2">💧 Začněte s pravidelným zálivkou – jarní deště často nestačí.</string>
    <string name="tip_may_3">🌹 Odvažte a rozmotejte přikrývky růží a trvalek.</string>

    <!-- June Tips -->
    <string name="tip_june_1">☀️ Mulčujte půdu pro zadržení vlhkosti a potlačení plevele.</string>
    <string name="tip_june_2">💧 Zaléve jte ráno nebo večer, vyhněte se poledni.</string>
    <string name="tip_june_3">🍓 Sběr jahod – nenechávejte ovoce na keřích příliš dlouho.</string>

    <!-- July Tips -->
    <string name="tip_july_1">🌡️ Zkontrolujte index UV – omezte práci na zahradě mezi 11. a 15. hodinou.</string>
    <string name="tip_july_2">💧 Zelenina v horku vyžaduje denní zalévání, zejména rajčata.</string>
    <string name="tip_july_3">🌿 Sklízejte byliny ráno, kdy jsou silice nejintenzivnější.</string>

    <!-- August Tips -->
    <string name="tip_august_1">🥦 Zasejte podzimní zeleninu: brokolice, kedlubny, salát.</string>
    <string name="tip_august_2">🍎 Sklízejte rané odrůdy jablek a švestek.</string>
    <string name="tip_august_3">💧 Snižte zalévání na konci měsíce pro otužení rostlin.</string>

    <!-- September Tips -->
    <string name="tip_september_1">🌾 Sklízejte dýně a cukety před prvními mrazíky.</string>
    <string name="tip_september_2">🧅 Vysazujte cibule tulipánů, narcisů a hyacintů.</string>
    <string name="tip_september_3">❄️ Připravte netkanou textilii – mrazíky se mohou objevit tento měsíc.</string>

    <!-- October Tips -->
    <string name="tip_october_1">🌹 Přikryjte růže a trvalky citlivé na mráz.</string>
    <string name="tip_october_2">🥕 Sklízejte kořenovou zeleninu: mrkev, petržel, pastinák – mráz je osladí.</string>
    <string name="tip_october_3">🍂 Kompostujte listí – vynikající hnojivo na příští rok.</string>

    <!-- November Tips -->
    <string name="tip_november_1">❄️ Chraňte rostliny před mrazem: netkaná textilie, sláma, jehličí.</string>
    <string name="tip_november_2">🪴 Přemístěte citlivé květináče do chladné místnosti.</string>
    <string name="tip_november_3">📋 Poznamenejte si pozorování z končící sezóny pro lepší plánování.</string>

    <!-- December Tips -->
    <string name="tip_december_1">🌟 Zkontrolujte přikrývky po silných sněžení.</string>
    <string name="tip_december_2">📚 Čas na čtení o zahradničení a plánování zahrady na nový rok.</string>
    <string name="tip_december_3">🐦 Pamatujte na ptáky v zahradě – pověste krmítko.</string>

