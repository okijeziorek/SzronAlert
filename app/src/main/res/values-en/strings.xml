    <!-- January Tips -->
    <string name="tip_january_1">❄️ Check winter plant covers after each thaw.</string>
    <string name="tip_january_2">📋 Plan your garden for the upcoming season, order seeds from catalogs.</string>
    <string name="tip_january_3">✂️ Prune fruit trees during frost when sap is not flowing.</string>

    <!-- February Tips -->
    <string name="tip_february_1">🌱 Start sowing vegetables for seedlings at home (tomatoes, peppers).</string>
    <string name="tip_february_2">✂️ Prune ornamental shrubs before they wake up.</string>
    <string name="tip_february_3">🐛 Check plants for pests overwintering under bark.</string>

    <!-- March Tips -->
    <string name="tip_march_1">🌷 Remove winter covers when temperatures don\'t drop below -5°C.</string>
    <string name="tip_march_2">🌱 Sow early vegetables: lettuce, spinach, radish.</string>
    <string name="tip_march_3">💧 Resume watering when soil thaws in layers.</string>

    <!-- April Tips -->
    <string name="tip_april_1">⚠️ Watch out for frosts! May is the month of \'Ice Saints\'.</string>
    <string name="tip_april_2">🍅 Transplant seedlings into pots, don\'t put outside before May 15.</string>
    <string name="tip_april_3">🌿 Sow herbs in the ground: parsley, dill, coriander.</string>

    <!-- May Tips -->
    <string name="tip_may_1">🌡️ After May 15, plant warm-loving vegetable seedlings outside.</string>
    <string name="tip_may_2">💧 Start regular watering – spring rains are often insufficient.</string>
    <string name="tip_may_3">🌹 Untie and unroll rose and perennial covers.</string>

    <!-- June Tips -->
    <string name="tip_june_1">☀️ Mulch soil to retain moisture and inhibit weeds.</string>
    <string name="tip_june_2">💧 Water in the morning or evening, avoid midday.</string>
    <string name="tip_june_3">🍓 Strawberry harvest – don\'t leave fruit on bushes too long.</string>

    <!-- July Tips -->
    <string name="tip_july_1">🌡️ Check UV index – limit garden work between 11 AM and 3 PM.</string>
    <string name="tip_july_2">💧 Vegetables in heat require daily watering, especially tomatoes.</string>
    <string name="tip_july_3">🌿 Harvest herbs in the morning when essential oils are most intense.</string>

    <!-- August Tips -->
    <string name="tip_august_1">🥦 Sow autumn vegetables: broccoli, kohlrabi, lettuce.</string>
    <string name="tip_august_2">🍎 Harvest early varieties of apples and plums.</string>
    <string name="tip_august_3">💧 Reduce watering at end of month to harden plants.</string>

    <!-- September Tips -->
    <string name="tip_september_1">🌾 Harvest pumpkins and zucchini before first frosts.</string>
    <string name="tip_september_2">🧅 Plant tulip, daffodil and hyacinth bulbs.</string>
    <string name="tip_september_3">❄️ Prepare fleece – frosts may appear this month.</string>

    <!-- October Tips -->
    <string name="tip_october_1">🌹 Cover roses and frost-sensitive perennials.</string>
    <string name="tip_october_2">🥕 Harvest root vegetables: carrots, parsley, parsnips – frost sweetens them.</string>
    <string name="tip_october_3">🍂 Compost leaves – excellent fertilizer for next year.</string>

    <!-- November Tips -->
    <string name="tip_november_1">❄️ Protect plants from frost: fleece, straw, pine needles.</string>
    <string name="tip_november_2">🪴 Move sensitive potted plants to a cool room.</string>
    <string name="tip_november_3">📋 Note observations from the ending season to plan better.</string>

    <!-- December Tips -->
    <string name="tip_december_1">🌟 Check covers after heavy snowfall.</string>
    <string name="tip_december_2">📚 Time for gardening reading and planning garden for new year.</string>
    <string name="tip_december_3">🐦 Remember birds in the garden – hang a feeder.</string>

