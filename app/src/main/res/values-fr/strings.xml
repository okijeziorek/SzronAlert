    <!-- Garden Seasonal Tips -->
    <string name="garden_seasonal_tip_format">%1$s %2$s</string>

    <!-- January Tips -->
    <string name="tip_january_1">❄️ Vérifiez les couvertures des plantes d\'hiver après chaque dégel.</string>
    <string name="tip_january_2">📋 Planifiez votre jardin pour la saison à venir, commandez des graines dans les catalogues.</string>
    <string name="tip_january_3">✂️ Taillez les arbres fruitiers pendant le gel lorsque la sève ne coule pas.</string>

    <!-- February Tips -->
    <string name="tip_february_1">🌱 Commencez à semer les légumes pour les semis à la maison (tomates, poivrons).</string>
    <string name="tip_february_2">✂️ Taillez les arbustes ornementaux avant qu\'ils ne se réveillent.</string>
    <string name="tip_february_3">🐛 Vérifiez les plantes pour les parasites hivernant sous l\'écorce.</string>

    <!-- March Tips -->
    <string name="tip_march_1">🌷 Retirez les couvertures d\'hiver lorsque les températures ne descendent pas en dessous de -5°C.</string>
    <string name="tip_march_2">🌱 Semez les légumes précoces : laitue, épinards, radis.</string>
    <string name="tip_march_3">💧 Reprenez l\'arrosage lorsque le sol dégèle en couches.</string>

    <!-- April Tips -->
    <string name="tip_april_1">⚠️ Attention aux gelées ! Mai est le mois des \'Saints de Glace\'.</string>
    <string name="tip_april_2">🍅 Transplantez les semis dans des pots, ne les sortez pas avant le 15 mai.</string>
    <string name="tip_april_3">🌿 Semez les herbes en pleine terre : persil, aneth, coriandre.</string>

    <!-- May Tips -->
    <string name="tip_may_1">🌡️ Après le 15 mai, plantez les semis de légumes qui aiment la chaleur à l\'extérieur.</string>
    <string name="tip_may_2">💧 Commencez l\'arrosage régulier – les pluies printanières sont souvent insuffisantes.</string>
    <string name="tip_may_3">🌹 Détachez et déroulez les couvertures de roses et de vivaces.</string>

    <!-- June Tips -->
    <string name="tip_june_1">☀️ Paillez le sol pour retenir l\'humidité et inhiber les mauvaises herbes.</string>
    <string name="tip_june_2">💧 Arrosez le matin ou le soir, évitez midi.</string>
    <string name="tip_june_3">🍓 Récolte de fraises – ne laissez pas les fruits sur les buissons trop longtemps.</string>

    <!-- July Tips -->
    <string name="tip_july_1">🌡️ Vérifiez l\'indice UV – limitez le travail au jardin entre 11h et 15h.</string>
    <string name="tip_july_2">💧 Les légumes par forte chaleur nécessitent un arrosage quotidien, surtout les tomates.</string>
    <string name="tip_july_3">🌿 Récoltez les herbes le matin lorsque les huiles essentielles sont les plus intenses.</string>

    <!-- August Tips -->
    <string name="tip_august_1">🥦 Semez les légumes d\'automne : brocoli, chou-rave, laitue.</string>
    <string name="tip_august_2">🍎 Récoltez les variétés précoces de pommes et de prunes.</string>
    <string name="tip_august_3">💧 Réduisez l\'arrosage en fin de mois pour endurcir les plantes.</string>

    <!-- September Tips -->
    <string name="tip_september_1">🌾 Récoltez les citrouilles et les courgettes avant les premières gelées.</string>
    <string name="tip_september_2">🧅 Plantez les bulbes de tulipes, jonquilles et jacinthes.</string>
    <string name="tip_september_3">❄️ Préparez le voile – les gelées peuvent apparaître ce mois-ci.</string>

    <!-- October Tips -->
    <string name="tip_october_1">🌹 Couvrez les roses et les vivaces sensibles au gel.</string>
    <string name="tip_october_2">🥕 Récoltez les légumes-racines : carottes, persil, panais – le gel les adoucit.</string>
    <string name="tip_october_3">🍂 Compostez les feuilles – excellent engrais pour l\'année prochaine.</string>

    <!-- November Tips -->
    <string name="tip_november_1">❄️ Protégez les plantes du gel : voile, paille, aiguilles de pin.</string>
    <string name="tip_november_2">🪴 Déplacez les plantes en pot sensibles dans une pièce fraîche.</string>
    <string name="tip_november_3">📋 Notez les observations de la saison qui se termine pour mieux planifier.</string>

    <!-- December Tips -->
    <string name="tip_december_1">🌟 Vérifiez les couvertures après de fortes chutes de neige.</string>
    <string name="tip_december_2">📚 Temps pour la lecture sur le jardinage et la planification du jardin pour la nouvelle année.</string>
    <string name="tip_december_3">🐦 N\'oubliez pas les oiseaux du jardin – suspendez une mangeoire.</string>

