    <!-- January Tips -->
    <string name="tip_january_1">❄️ Перевірте зимові накриття рослин після кожної відлиги.</string>
    <string name="tip_january_2">📋 Сплануйте сад на наступний сезон, замовте насіння з каталогів.</string>
    <string name="tip_january_3">✂️ Обрізайте плодові дерева під час морозу, коли сік не тече.</string>

    <!-- February Tips -->
    <string name="tip_february_1">🌱 Почніть посів овочів на розсаду вдома (помідори, перець).</string>
    <string name="tip_february_2">✂️ Обріжіть декоративні чагарники до їх пробудження.</string>
    <string name="tip_february_3">🐛 Перевірте рослини на шкідників, що зимують під корою.</string>

    <!-- March Tips -->
    <string name="tip_march_1">🌷 Зніміть зимові накриття, коли температура не опускається нижче -5°C.</string>
    <string name="tip_march_2">🌱 Посійте ранні овочі: салат, шпинат, редиску.</string>
    <string name="tip_march_3">💧 Відновіть полив, коли ґрунт відтає шарами.</string>

    <!-- April Tips -->
    <string name="tip_april_1">⚠️ Увага на заморозки! Травень - місяць \'Крижаних святих\'.</string>
    <string name="tip_april_2">🍅 Пересадіть розсаду в горщики, не виносьте до 15 травня.</string>
    <string name="tip_april_3">🌿 Посійте трави прямо в ґрунт: петрушка, кріп, коріандр.</string>

    <!-- May Tips -->
    <string name="tip_may_1">🌡️ Після 15 травня висадіть розсаду теплолюбних овочів назовні.</string>
    <string name="tip_may_2">💧 Почніть регулярний полив – весняних дощів часто недостатньо.</string>
    <string name="tip_may_3">🌹 Розв\'яжіть і розмотайте накриття троянд і багаторічників.</string>

    <!-- June Tips -->
    <string name="tip_june_1">☀️ Мульчуйте ґрунт для утримання вологи та придушення бур\'янів.</string>
    <string name="tip_june_2">💧 Поливайте вранці або ввечері, уникайте обіду.</string>
    <string name="tip_june_3">🍓 Збір полуниць – не залишайте плоди на кущах надто довго.</string>

    <!-- July Tips -->
    <string name="tip_july_1">🌡️ Перевірте індекс УФ – обмежте роботу в саду між 11 і 15 годинами.</string>
    <string name="tip_july_2">💧 Овочі у спеку потребують щоденного поливу, особливо помідори.</string>
    <string name="tip_july_3">🌿 Збирайте трави вранці, коли ефірні олії найінтенсивніші.</string>

    <!-- August Tips -->
    <string name="tip_august_1">🥦 Посійте осінні овочі: броколі, кольрабі, салат.</string>
    <string name="tip_august_2">🍎 Збирайте ранні сорти яблук і слив.</string>
    <string name="tip_august_3">💧 Зменште полив наприкінці місяця для загартування рослин.</string>

    <!-- September Tips -->
    <string name="tip_september_1">🌾 Збирайте гарбузи та кабачки до перших заморозків.</string>
    <string name="tip_september_2">🧅 Висаджуйте цибулини тюльпанів, нарцисів і гіацинтів.</string>
    <string name="tip_september_3">❄️ Підготуйте нетканий матеріал – заморозки можуть з\'явитися цього місяця.</string>

    <!-- October Tips -->
    <string name="tip_october_1">🌹 Накрийте троянди та багаторічники, чутливі до морозу.</string>
    <string name="tip_october_2">🥕 Збирайте кореневі овочі: морква, петрушка, пастернак – мороз їх підсолодить.</string>
    <string name="tip_october_3">🍂 Компостуйте листя – чудове добриво на наступний рік.</string>

    <!-- November Tips -->
    <string name="tip_november_1">❄️ Захистіть рослини від морозу: нетканий матеріал, солома, хвоя.</string>
    <string name="tip_november_2">🪴 Перемістіть чутливі горщики у прохолодне приміщення.</string>
    <string name="tip_november_3">📋 Запишіть спостереження із сезону, що закінчується, для кращого планування.</string>

    <!-- December Tips -->
    <string name="tip_december_1">🌟 Перевірте накриття після сильних снігопадів.</string>
    <string name="tip_december_2">📚 Час для читання про садівництво та планування саду на новий рік.</string>
    <string name="tip_december_3">🐦 Пам\'ятайте про птахів у саду – повісьте годівничку.</string>

