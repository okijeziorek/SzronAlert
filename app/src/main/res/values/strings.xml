    <!-- Garden Seasonal Tips -->
    <string name="garden_seasonal_tip_format">%1$s %2$s</string>

    <!-- January Tips -->
    <string name="tip_january_1">❄️ Sprawdź okrycia zimowe roślin po każdej odwilży.</string>
    <string name="tip_january_2">📋 Planuj ogród na nadchodzący sezon, zamów nasiona z katalogów.</string>
    <string name="tip_january_3">✂️ Przycinaj drzewa owocowe w czasie mrozów, gdy soki nie płyną.</string>

    <!-- February Tips -->
    <string name="tip_february_1">🌱 Zacznij wysiew warzyw na rozsady w domu (pomidory, papryki).</string>
    <string name="tip_february_2">✂️ Przycinaj krzewy ozdobne przed przebudzeniem.</string>
    <string name="tip_february_3">🐛 Sprawdź rośliny pod kątem szkodników zimujących pod korą.</string>

    <!-- March Tips -->
    <string name="tip_march_1">🌷 Zdejmuj okrycia zimowe gdy temperatury nie spadają poniżej -5°C.</string>
    <string name="tip_march_2">🌱 Wysiej warzywa wczesne: sałatę, szpinak, rzodkiewkę.</string>
    <string name="tip_march_3">💧 Wznów podlewanie, gdy ziemia odmrozi się w warstwach.</string>

    <!-- April Tips -->
    <string name="tip_april_1">⚠️ Uwaga na przymrozki! Maj to miesiąc \'zimnych ogrodników\'.</string>
    <string name="tip_april_2">🍅 Przesadzaj rozsady do doniczek, nie wstawiaj na zewnątrz przed 15 maja.</string>
    <string name="tip_april_3">🌿 Siej zioła w gruncie: pietruszka, koper, kolendra.</string>

    <!-- May Tips -->
    <string name="tip_may_1">🌡️ Po 15 maja sadzaj rozsady ciepłolubnych warzyw na zewnątrz.</string>
    <string name="tip_may_2">💧 Zacznij regularnie podlewać – deszcze wiosenne często są niewystarczające.</string>
    <string name="tip_may_3">🌹 Odwiązuj i rozwijaj okrycia róż i bylin.</string>

    <!-- June Tips -->
    <string name="tip_june_1">☀️ Mulchuj glebę, by zatrzymać wilgoć i hamować chwasty.</string>
    <string name="tip_june_2">💧 Podlewaj rano lub wieczorem, unikaj południa.</string>
    <string name="tip_june_3">🍓 Zbiory truskawek – nie zostawiaj owoców na krzakach za długo.</string>

    <!-- July Tips -->
    <string name="tip_july_1">🌡️ Sprawdź indeks UV – ogranicz pracę w ogrodzie między 11 a 15.</string>
    <string name="tip_july_2">💧 Warzywa w skwarze wymagają codziennego podlewania, szczególnie pomidory.</string>
    <string name="tip_july_3">🌿 Zbieraj zioła rano, gdy olejki eteryczne są najbardziej intensywne.</string>

    <!-- August Tips -->
    <string name="tip_august_1">🥦 Siej warzywa jesienne: brokuły, kalarepę, sałatę.</string>
    <string name="tip_august_2">🍎 Zbiory wcześniejszych odmian jabłek i śliwek.</string>
    <string name="tip_august_3">💧 Ogranicz podlewanie pod koniec miesiąca, by zahartować rośliny.</string>

    <!-- September Tips -->
    <string name="tip_september_1">🌾 Zbiory dyni i cukinii przed pierwszymi przymrozkami.</string>
    <string name="tip_september_2">🧅 Sadzaj cebule tulipanów, narcyzów i hiacyntów.</string>
    <string name="tip_september_3">❄️ Przygotuj agrowłókninę – przymrozki mogą pojawić się już w tym miesiącu.</string>

    <!-- October Tips -->
    <string name="tip_october_1">🌹 Okrywaj róże i byliny wrażliwe na mróz.</string>
    <string name="tip_october_2">🥕 Zbieraj korzeniowe: marchew, pietruszkę, pasternak – mróz je dosładza.</string>
    <string name="tip_october_3">🍂 Kompostuj liście – doskonały nawóz na przyszły rok.</string>

    <!-- November Tips -->
    <string name="tip_november_1">❄️ Zabezpieczaj rośliny przed mrozem: agrowłóknina, słoma, igliwie.</string>
    <string name="tip_november_2">🪴 Przenieś doniczkowe rośliny wrażliwe do chłodnego pomieszczenia.</string>
    <string name="tip_november_3">📋 Notuj obserwacje z kończącego się sezonu, by planować lepiej.</string>

    <!-- December Tips -->
    <string name="tip_december_1">🌟 Sprawdzaj okrycia po intensywnych opadach śniegu.</string>
    <string name="tip_december_2">📚 Czas na lektury ogrodnicze i planowanie ogrodu na nowy rok.</string>
    <string name="tip_december_3">🐦 Pamiętaj o ptakach w ogrodzie – zawieś karmnik.</string>

