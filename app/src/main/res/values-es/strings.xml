    <!-- Garden Seasonal Tips -->
    <string name="garden_seasonal_tip_format">%1$s %2$s</string>

    <!-- January Tips -->
    <string name="tip_january_1">❄️ Revisa las cubiertas de plantas de invierno después de cada deshielo.</string>
    <string name="tip_january_2">📋 Planifica tu jardín para la próxima temporada, pide semillas de catálogos.</string>
    <string name="tip_january_3">✂️ Poda los árboles frutales durante las heladas cuando la savia no fluye.</string>

    <!-- February Tips -->
    <string name="tip_february_1">🌱 Comienza a sembrar hortalizas para plántulas en casa (tomates, pimientos).</string>
    <string name="tip_february_2">✂️ Poda arbustos ornamentales antes de que despierten.</string>
    <string name="tip_february_3">🐛 Revisa las plantas en busca de plagas que hibernan bajo la corteza.</string>

    <!-- March Tips -->
    <string name="tip_march_1">🌷 Retira las cubiertas de invierno cuando las temperaturas no bajen de -5°C.</string>
    <string name="tip_march_2">🌱 Siembra hortalizas tempranas: lechuga, espinacas, rábanos.</string>
    <string name="tip_march_3">💧 Reanuda el riego cuando el suelo se descongele en capas.</string>

    <!-- April Tips -->
    <string name="tip_april_1">⚠️ ¡Cuidado con las heladas! Mayo es el mes de los \'Santos de Hielo\'.</string>
    <string name="tip_april_2">🍅 Trasplanta las plántulas a macetas, no las saques antes del 15 de mayo.</string>
    <string name="tip_april_3">🌿 Siembra hierbas en el suelo: perejil, eneldo, cilantro.</string>

    <!-- May Tips -->
    <string name="tip_may_1">🌡️ Después del 15 de mayo, planta plántulas de hortalizas amantes del calor al aire libre.</string>
    <string name="tip_may_2">💧 Comienza el riego regular – las lluvias primaverales suelen ser insuficientes.</string>
    <string name="tip_may_3">🌹 Desata y desenrolla las cubiertas de rosas y perennes.</string>

    <!-- June Tips -->
    <string name="tip_june_1">☀️ Acolcha el suelo para retener la humedad e inhibir las malas hierbas.</string>
    <string name="tip_june_2">💧 Riega por la mañana o por la tarde, evita el mediodía.</string>
    <string name="tip_june_3">🍓 Cosecha de fresas – no dejes la fruta en los arbustos demasiado tiempo.</string>

    <!-- July Tips -->
    <string name="tip_july_1">🌡️ Revisa el índice UV – limita el trabajo en el jardín entre las 11 y las 15h.</string>
    <string name="tip_july_2">💧 Las hortalizas en el calor requieren riego diario, especialmente los tomates.</string>
    <string name="tip_july_3">🌿 Cosecha hierbas por la mañana cuando los aceites esenciales son más intensos.</string>

    <!-- August Tips -->
    <string name="tip_august_1">🥦 Siembra hortalizas de otoño: brócoli, colinabo, lechuga.</string>
    <string name="tip_august_2">🍎 Cosecha variedades tempranas de manzanas y ciruelas.</string>
    <string name="tip_august_3">💧 Reduce el riego a finales de mes para endurecer las plantas.</string>

    <!-- September Tips -->
    <string name="tip_september_1">🌾 Cosecha calabazas y calabacines antes de las primeras heladas.</string>
    <string name="tip_september_2">🧅 Planta bulbos de tulipanes, narcisos y jacintos.</string>
    <string name="tip_september_3">❄️ Prepara la malla – las heladas pueden aparecer este mes.</string>

    <!-- October Tips -->
    <string name="tip_october_1">🌹 Cubre las rosas y las perennes sensibles a las heladas.</string>
    <string name="tip_october_2">🥕 Cosecha hortalizas de raíz: zanahorias, perejil, chirivías – las heladas las endulzan.</string>
    <string name="tip_october_3">🍂 Compostea las hojas – excelente fertilizante para el próximo año.</string>

    <!-- November Tips -->
    <string name="tip_november_1">❄️ Protege las plantas de las heladas: malla, paja, agujas de pino.</string>
    <string name="tip_november_2">🪴 Traslada las plantas en macetas sensibles a una habitación fresca.</string>
    <string name="tip_november_3">📋 Anota observaciones de la temporada que termina para planificar mejor.</string>

    <!-- December Tips -->
    <string name="tip_december_1">🌟 Revisa las cubiertas después de nevadas fuertes.</string>
    <string name="tip_december_2">📚 Tiempo para lectura sobre jardinería y planificar el jardín para el nuevo año.</string>
    <string name="tip_december_3">🐦 Recuerda las aves en el jardín – cuelga un comedero.</string>

