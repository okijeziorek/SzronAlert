    <!-- Garden Seasonal Tips -->
    <string name="garden_seasonal_tip_format">%1$s %2$s</string>

    <!-- January Tips -->
    <string name="tip_january_1">❄️ Controlla le coperture delle piante invernali dopo ogni disgelo.</string>
    <string name="tip_january_2">📋 Pianifica il giardino per la prossima stagione, ordina semi dai cataloghi.</string>
    <string name="tip_january_3">✂️ Pota gli alberi da frutto durante il gelo quando la linfa non scorre.</string>

    <!-- February Tips -->
    <string name="tip_february_1">🌱 Inizia a seminare ortaggi per piantine in casa (pomodori, peperoni).</string>
    <string name="tip_february_2">✂️ Pota gli arbusti ornamentali prima che si risveglino.</string>
    <string name="tip_february_3">🐛 Controlla le piante per parassiti che svernano sotto la corteccia.</string>

    <!-- March Tips -->
    <string name="tip_march_1">🌷 Rimuovi le coperture invernali quando le temperature non scendono sotto -5°C.</string>
    <string name="tip_march_2">🌱 Semina ortaggi precoci: lattuga, spinaci, ravanelli.</string>
    <string name="tip_march_3">💧 Riprendi l\'irrigazione quando il terreno si scongela a strati.</string>

    <!-- April Tips -->
    <string name="tip_april_1">⚠️ Attento alle gelate! Maggio è il mese dei \'Santi del Ghiaccio\'.</string>
    <string name="tip_april_2">🍅 Trapianta le piantine in vasi, non metterle fuori prima del 15 maggio.</string>
    <string name="tip_april_3">🌿 Semina erbe aromatiche in piena terra: prezzemolo, aneto, coriandolo.</string>

    <!-- May Tips -->
    <string name="tip_may_1">🌡️ Dopo il 15 maggio, pianta piantine di ortaggi amanti del caldo all\'esterno.</string>
    <string name="tip_may_2">💧 Inizia l\'irrigazione regolare – le piogge primaverili sono spesso insufficienti.</string>
    <string name="tip_may_3">🌹 Slega e srotola le coperture di rose e perenni.</string>

    <!-- June Tips -->
    <string name="tip_june_1">☀️ Pacciama il terreno per trattenere l\'umidità e inibire le erbacce.</string>
    <string name="tip_june_2">💧 Annaffia al mattino o alla sera, evita il mezzogiorno.</string>
    <string name="tip_june_3">🍓 Raccolta fragole – non lasciare i frutti sui cespugli troppo a lungo.</string>

    <!-- July Tips -->
    <string name="tip_july_1">🌡️ Controlla l\'indice UV – limita il lavoro in giardino tra le 11 e le 15.</string>
    <string name="tip_july_2">💧 Gli ortaggi al caldo richiedono irrigazione quotidiana, specialmente i pomodori.</string>
    <string name="tip_july_3">🌿 Raccogli le erbe al mattino quando gli oli essenziali sono più intensi.</string>

    <!-- August Tips -->
    <string name="tip_august_1">🥦 Semina ortaggi autunnali: broccoli, cavolo rapa, lattuga.</string>
    <string name="tip_august_2">🍎 Raccogli varietà precoci di mele e prugne.</string>
    <string name="tip_august_3">💧 Riduci l\'irrigazione a fine mese per indurire le piante.</string>

    <!-- September Tips -->
    <string name="tip_september_1">🌾 Raccogli zucche e zucchine prima delle prime gelate.</string>
    <string name="tip_september_2">🧅 Pianta bulbi di tulipani, narcisi e giacinti.</string>
    <string name="tip_september_3">❄️ Prepara il tessuto non tessuto – le gelate possono comparire questo mese.</string>

    <!-- October Tips -->
    <string name="tip_october_1">🌹 Copri le rose e le perenni sensibili al gelo.</string>
    <string name="tip_october_2">🥕 Raccogli ortaggi a radice: carote, prezzemolo, pastinache – il gelo le addolcisce.</string>
    <string name="tip_october_3">🍂 Composta le foglie – ottimo fertilizzante per l\'anno prossimo.</string>

    <!-- November Tips -->
    <string name="tip_november_1">❄️ Proteggi le piante dal gelo: tessuto non tessuto, paglia, aghi di pino.</string>
    <string name="tip_november_2">🪴 Sposta le piante in vaso sensibili in una stanza fresca.</string>
    <string name="tip_november_3">📋 Annota le osservazioni della stagione in chiusura per pianificare meglio.</string>

    <!-- December Tips -->
    <string name="tip_december_1">🌟 Controlla le coperture dopo forti nevicate.</string>
    <string name="tip_december_2">📚 Tempo per letture sul giardinaggio e pianificazione del giardino per il nuovo anno.</string>
    <string name="tip_december_3">🐦 Ricorda gli uccelli in giardino – appendi una mangiatoia.</string>

